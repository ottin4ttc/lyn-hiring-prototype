{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lyn-hiring/harness/privacy-check/v1",
  "title": "PrivacyCheckReport",
  "description": "隐私与外部触达风险检查报告。BLOCKED 时 progress-manifest 不得对外发布。",
  "type": "object",
  "required": ["meta", "summary", "checks"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "dry_run": { "type": "boolean", "const": true },
        "issues_scanned": { "type": "integer" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["risk_level", "recommendation"],
      "properties": {
        "risk_level": {
          "type": "string",
          "enum": ["CLEAR", "LOW", "MEDIUM", "HIGH", "BLOCKED"],
          "description": "CLEAR=无风险；LOW=仅 WARN/guardrail-mention；BLOCKED=有 actual-risk PII、真实候选人数据、外部触达或真实系统写入 FAIL，必须人工处理后才能继续"
        },
        "recommendation": {
          "type": "string",
          "enum": ["continue", "review", "block"],
          "description": "continue=可继续 dry-run；review=需要人工确认后继续；block=必须停止"
        },
        "pii_signals_count": { "type": "integer" },
        "external_action_signals_count": { "type": "integer" },
        "real_candidate_signals_count": { "type": "integer" },
        "actual_risk_count": {
          "type": "integer",
          "description": "需要立即处理的 actual-risk FAIL 信号数量"
        },
        "guardrail_mention_count": {
          "type": "integer",
          "description": "识别为否定/边界描述的 guardrail-mention 信号数量（常见 false-positive）"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/definitions/CheckItem" }
    }
  },
  "definitions": {
    "CheckItem": {
      "type": "object",
      "required": ["check_id", "check_name", "status", "source_ref"],
      "properties": {
        "check_id": { "type": "string" },
        "check_name": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["pii", "external_action", "real_candidate", "internal_safety"]
        },
        "classification": {
          "type": "string",
          "enum": ["actual-risk", "guardrail-mention"],
          "description": "actual-risk=实际 PII/外部触达行为；guardrail-mention=否定/禁止/边界声明，常见 false-positive 来源"
        },
        "status": {
          "type": "string",
          "enum": ["PASS", "WARN", "FAIL"]
        },
        "description": { "type": "string" },
        "raw_signals": {
          "type": "array",
          "items": { "type": "string" },
          "description": "规则匹配到的原始字符串（最多 2 条）"
        },
        "judgment_reason": {
          "type": "string",
          "description": "判定为 actual-risk 或 guardrail-mention 的理由"
        },
        "human_review": {
          "type": "string",
          "description": "针对当前分类的人工复核建议"
        },
        "source_ref": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "id": { "type": "string" },
              "identifier": { "type": "string" },
              "field": { "type": "string" },
              "matched_pattern": { "type": "string" },
              "excerpt": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "remediation": { "type": "string" }
      }
    }
  }
}
